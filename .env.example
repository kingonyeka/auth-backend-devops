# ---- App ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_system_dev

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- RabbitMQ (local dev) ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ---- JWT ----
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- OAuth (Google example) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---- Email (AWS SES) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@yourdomain.com

# ---- SMS (Twilio or AWS SNS) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- AWS SQS (staging/prod queue) ----
SQS_QUEUE_URL=

# ---- Secrets Manager (staging/prod only) ----
AWS_SECRETS_MANAGER_SECRET_NAME=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# ---- Sentry ----
SENTRY_DSN=

# ---- Logging ----
LOG_LEVEL=debug